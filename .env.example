WHOOP_CLIENT_ID=your-client-id
WHOOP_CLIENT_SECRET=your-client-secret
WHOOP_REDIRECT_URI=http://localhost:8080/callback

# Required: markdown journal directory for --write mode.
VAULT_JOURNAL_DIR=/Users/you/Documents/Obsidian/01_Projects/Journal

# Optional environment context via Open-Meteo.
WEATHER_ENABLED=true
WEATHER_LAT=35.6503
WEATHER_LON=139.7225

# Optional air quality context via Japan's soramame API.
AIRQUALITY_ENABLED=true
AIRQUALITY_STATION_CODE=13103010
