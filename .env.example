WHOOP_CLIENT_ID=your-client-id
WHOOP_CLIENT_SECRET=your-client-secret
WHOOP_REDIRECT_URI=http://localhost:8080/callback

# Optional: markdown journal directory for --write mode.
# JOURNAL_DIR is the primary key. VAULT_JOURNAL_DIR still works as a deprecated alias.
JOURNAL_DIR=/Users/you/journal

# Optional environment context via Open-Meteo.
WEATHER_ENABLED=true
WEATHER_LAT=35.6503
WEATHER_LON=139.7225

# Optional air quality context via Open-Meteo Air Quality.
AIRQUALITY_ENABLED=true
